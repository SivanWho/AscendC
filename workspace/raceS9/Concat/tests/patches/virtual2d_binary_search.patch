+    __aicore__ inline uint32_t FindFirstInput(
+        const ConcatTilingData &t, uint64_t virtualBeginBytes) const
+    {
+        uint32_t low = 0;
+        uint32_t high = inputCount_;
+        while (low < high) {
+            const uint32_t middle = low + (high - low) / 2;
+            const uint64_t inputEndBytes =
+                (t.axisPrefixes[middle] + t.axisSizes[middle]) *
+                inner_ * sizeof(T);
+            if (inputEndBytes <= virtualBeginBytes) {
+                low = middle + 1;
+            } else {
+                high = middle;
+            }
+        }
+        return low;
+    }
